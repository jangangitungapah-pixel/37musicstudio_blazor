        ["columns-3"] = new StudioIconDefinition(24, 24, @"<g fill=""none"" stroke=""currentColor"" stroke-linecap=""round"" stroke-linejoin=""round"" stroke-width=""2""><rect width=""18"" height=""18"" x=""3"" y=""3"" rx=""2""/><path d=""M9 3v18m6-18v18""/></g>"),
        ["calendar-range"] = new StudioIconDefinition(24, 24, @"<g fill=""none"" stroke=""currentColor"" stroke-linecap=""round"" stroke-linejoin=""round"" stroke-width=""2""><rect width=""18"" height=""18"" x=""3"" y=""4"" rx=""2""/><path d=""M16 2v4M3 10h18M8 2v4m9 8h-6m2 4H7m0-4h.01M17 18h.01""/></g>")
