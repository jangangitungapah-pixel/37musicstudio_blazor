@using Microsoft.AspNetCore.Components

<span class="@ClassName" aria-hidden="@AriaHiddenValue" role="@RoleValue" title="@Title">
    <svg viewBox="@ViewBox" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
        @((MarkupString)Icon.Body)
    </svg>
</span>

@code {
    [Parameter]
    public string Name { get; set; } = "circle-dot";

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public bool Decorative { get; set; } = true;

    private StudioIconDefinition Icon => Icons.TryGetValue(Name, out var icon)
        ? icon
        : Icons["circle-dot"];

    private string ViewBox => $"0 0 {Icon.Width} {Icon.Height}";

    private string ClassName => string.IsNullOrWhiteSpace(Class)
        ? "studio-icon"
        : $"studio-icon {Class}";

    private string AriaHiddenValue => Decorative ? "true" : "false";

    private string? RoleValue => Decorative ? null : "img";

