@page "/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@layout StudioAdminLayout

@using System.Globalization
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.JSInterop

@inject IJSRuntime JsRuntime

<PageTitle>Settings | 37 Music Studio</PageTitle>

<section class="studio-settings-page" aria-labelledby="settingsTitle">
    <header class="studio-settings-header">
        <div>
            <p>Settings</p>
            <h1 id="settingsTitle">@CurrentSubPageTitle</h1>
            <span>@CurrentSubPageDescription</span>
        </div>

        <div class="studio-settings-actions">
            <button type="button" class="studio-settings-soft-action" @onclick="ResetCurrentSubPageAsync">
                Reset Default
            </button>

            <button type="button" class="studio-settings-primary-action" @onclick="SaveCurrentSubPageAsync">
                Simpan Settings
            </button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(FormMessage))
    {
        <div class="studio-settings-alert" role="alert">@FormMessage</div>
    }

    <section class="studio-settings-subpage-card" aria-label="Pilih subpage settings">
        <label class="studio-settings-field studio-settings-subpage-field">
            <span>Subpage Settings</span>

            <select value="@ActiveSubPage" @onchange="OnSubPageChanged">
                <option value="@SettingsSubPagePricing">Pricing</option>
                <option value="@SettingsSubPageProfile">Profile Studio</option>
                <option value="@SettingsSubPageGallery">Gallery</option>
            </select>
        </label>

        <div class="studio-settings-subpage-summary">
            <strong>@CurrentSubPageTitle</strong>
            <span>@CurrentSubPageDescription</span>
        </div>
    </section>

    @if (ActiveSubPage == SettingsSubPagePricing)
    {
        <section class="studio-settings-panel studio-pricing-vertical-panel">
            <div class="studio-settings-card is-hero-card studio-pricing-section-card">
                <div>
                    <p>Harga latihan reguler</p>
                    <h2>@FormatCurrency(PricingModel.HourlyRate)</h2>
                    <span>Default sistem: Rp120.000 per jam. Harga ini dipakai otomatis di halaman Schedule untuk booking latihan.</span>
                </div>

                <label class="studio-settings-field">
                    <span>Harga per jam</span>
                    <input type="number" min="0" step="1000" @bind="PricingModel.HourlyRate" @bind:event="oninput" />
                </label>
            </div>

            <div class="studio-settings-card studio-pricing-section-card">
                <header class="studio-settings-card-head">
                    <div>
                        <p>Paket Recording</p>
                        <h2>Tambah Paket</h2>
                        <span>Buat paket recording berisi nama paket, durasi, dan harga tetap.</span>
                    </div>
                </header>

                <div class="studio-settings-form-grid">
                    <label class="studio-settings-field">
                        <span>Nama paket</span>
                        <input type="text" placeholder="Contoh: Recording Basic" @bind="PackageDraft.Name" @bind:event="oninput" />
                    </label>

                    <label class="studio-settings-field">
                        <span>Durasi paket</span>
                        <input type="number" min="1" step="1" @bind="PackageDraft.DurationHours" @bind:event="oninput" />
                    </label>

                    <label class="studio-settings-field">
                        <span>Harga paket</span>
                        <input type="number" min="0" step="1000" @bind="PackageDraft.Price" @bind:event="oninput" />
                    </label>

                    <button type="button" class="studio-settings-add-action" @onclick="AddRecordingPackage">
                        Tambah Paket
                    </button>
                </div>

                <div class="studio-settings-list">
                    @if (!PricingModel.RecordingPackages.Any())
                    {
                        <div class="studio-settings-empty">
                            <strong>Belum ada paket recording</strong>
                            <span>Tambahkan paket untuk dipakai di halaman Schedule.</span>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in PricingModel.RecordingPackages)
                        {
                            <article class="studio-settings-row-card">
                                <label class="studio-settings-field">
                                    <span>Nama Paket</span>
                                    <input type="text" @bind="item.Name" @bind:event="oninput" />
                                </label>

                                <label class="studio-settings-field">
                                    <span>Durasi Jam</span>
                                    <input type="number" min="1" step="1" @bind="item.DurationHours" @bind:event="oninput" />
                                </label>

                                <label class="studio-settings-field">
                                    <span>Harga</span>
                                    <input type="number" min="0" step="1000" @bind="item.Price" @bind:event="oninput" />
                                </label>

                                <button type="button" class="studio-settings-danger-action" @onclick="() => RemoveRecordingPackage(item.Id)">
                                    Hapus
                                </button>
                            </article>
                        }
                    }
                </div>
            </div>

            <div class="studio-settings-card studio-pricing-section-card">
                <header class="studio-settings-card-head">
                    <div>
                        <p>Diskon sesi latihan</p>
                        <h2>Tambah Diskon</h2>
                        <span>Default: diskon Rp60.000 untuk 3 jam latihan. Bisa dibuat berlaku kelipatan.</span>
                    </div>
                </header>

                <div class="studio-settings-form-grid is-discount-grid">
                    <label class="studio-settings-field">
                        <span>Durasi jam latihan</span>
                        <input type="number" min="1" step="1" @bind="DiscountDraft.DurationHours" @bind:event="oninput" />
                    </label>

                    <label class="studio-settings-field">
                        <span>Nominal diskon</span>
                        <input type="number" min="0" step="1000" @bind="DiscountDraft.Amount" @bind:event="oninput" />
                    </label>

                    <label class="studio-settings-check-field">
                        <input type="checkbox" @bind="DiscountDraft.AppliesMultiple" />
                        <span>Berlaku kelipatan</span>
                    </label>

                    <button type="button" class="studio-settings-add-action" @onclick="AddTrainingDiscount">
                        Tambah Diskon
                    </button>
                </div>

                <div class="studio-settings-list">
                    @if (!PricingModel.TrainingDiscounts.Any())
                    {
                        <div class="studio-settings-empty">
                            <strong>Belum ada diskon latihan</strong>
                            <span>Default: Rp60.000 per 3 jam latihan.</span>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in PricingModel.TrainingDiscounts)
                        {
                            <article class="studio-settings-row-card is-discount-row">
                                <label class="studio-settings-field">
                                    <span>Durasi Jam</span>
                                    <input type="number" min="1" step="1" @bind="item.DurationHours" @bind:event="oninput" />
                                </label>

                                <label class="studio-settings-field">
                                    <span>Nominal Diskon</span>
                                    <input type="number" min="0" step="1000" @bind="item.Amount" @bind:event="oninput" />
                                </label>

                                <label class="studio-settings-check-field">
                                    <input type="checkbox" @bind="item.AppliesMultiple" />
                                    <span>Berlaku kelipatan</span>
                                </label>

                                <button type="button" class="studio-settings-danger-action" @onclick="() => RemoveTrainingDiscount(item.Id)">
                                    Hapus
                                </button>
                            </article>
                        }
                    }
                </div>
            </div>
        </section>
    }

    @if (ActiveSubPage == SettingsSubPageProfile)
    {
        <section class="studio-settings-panel">
            <div class="studio-settings-card studio-profile-card">
                <header class="studio-settings-card-head">
                    <div>
                        <p>Profile Studio</p>
                        <h2>Identitas Studio</h2>
                        <span>Data ini nanti bisa dipakai untuk invoice, billing, dan tampilan publik.</span>
                    </div>
                </header>

                <div class="studio-profile-form-grid">
                    <label class="studio-settings-field">
                        <span>Nama Studio</span>
                        <input type="text" placeholder="37 Music Studio" @bind="ProfileModel.StudioName" @bind:event="oninput" />
                    </label>

                    <label class="studio-settings-field">
                        <span>Nomor HP / WA</span>
                        <input type="tel" inputmode="tel" placeholder="08xxxxxxxxxx" @bind="ProfileModel.PhoneOrWhatsApp" @bind:event="oninput" />
                    </label>

                    <label class="studio-settings-field studio-profile-address-field">
                        <span>Alamat Studio</span>
                        <textarea rows="5" placeholder="Alamat lengkap studio..." @bind="ProfileModel.Address" @bind:event="oninput"></textarea>
                    </label>
                </div>
            </div>

            <div class="studio-profile-preview-card">
                <p>Preview Profile</p>

                <strong>@ProfileModel.SafeStudioName</strong>

                <span>@ProfileModel.SafePhoneOrWhatsApp</span>

                <address>@ProfileModel.SafeAddress</address>
            </div>
        </section>
    }
</section>

@code {
    private const string LocalPricingStorageKey = "37musicstudio.pricing-settings.v1";
    private const string LocalStudioProfileStorageKey = "37musicstudio.studio-profile.v1";
    private const string LocalCloudinarySettingsKey = "37musicstudio.cloudinary-settings.v1";

    private const string SettingsSubPagePricing = "pricing";
    private const string SettingsSubPageProfile = "profile";
    private const string SettingsSubPageGallery = "gallery";

    private static readonly CultureInfo IndonesianCulture = new("id-ID");
    private static readonly JsonSerializerOptions LocalJsonOptions = CreateLocalJsonOptions();

    private StudioPricingSettings PricingModel { get; set; } = StudioPricingSettings.CreateDefault();

    private StudioProfileSettings ProfileModel { get; set; } = StudioProfileSettings.CreateDefault();
    private StudioCloudinarySettings CloudinarySettings { get; set; } = StudioCloudinarySettings.CreateDefault();

    private RecordingPackageDraft PackageDraft { get; set; } = new();

    private TrainingDiscountDraft DiscountDraft { get; set; } = TrainingDiscountDraft.CreateDefault();

    private string ActiveSubPage { get; set; } = SettingsSubPagePricing;

    private string? FormMessage { get; set; }

    private bool HasLoadedSettings { get; set; }

    private string CurrentSubPageTitle => ActiveSubPage switch
    {
        SettingsSubPageProfile => "Profile Studio",
        SettingsSubPageGallery => "Gallery",
        _ => "Pricing"
    };

    private string CurrentSubPageDescription => ActiveSubPage switch
    {
        SettingsSubPageProfile => "Edit nama studio, nomor HP/WA, dan alamat studio.",
        SettingsSubPageGallery => "Atur Cloudinary Cloud Name, unsigned upload preset, dan folder gallery.",
        _ => "Atur harga latihan, paket recording, dan diskon sesi latihan."
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || HasLoadedSettings)
        {
            return;
        }

        HasLoadedSettings = true;
        await LoadPricingSettingsAsync();
        await LoadProfileSettingsAsync();
        await LoadCloudinarySettingsAsync();
        StateHasChanged();
    }

    private static JsonSerializerOptions CreateLocalJsonOptions()
    {
        var options = new JsonSerializerOptions(JsonSerializerDefaults.Web)
        {
            WriteIndented = false
        };

        options.Converters.Add(new JsonStringEnumConverter());

        return options;
    }

    private async Task LoadPricingSettingsAsync()
    {
        try
        {
            var json = await JsRuntime.InvokeAsync<string?>("localStorage.getItem", LocalPricingStorageKey);

            PricingModel = string.IsNullOrWhiteSpace(json)
                ? StudioPricingSettings.CreateDefault()
                : JsonSerializer.Deserialize<StudioPricingSettings>(json, LocalJsonOptions)?.Normalize() ?? StudioPricingSettings.CreateDefault();

            FormMessage = null;
        }
        catch (Exception ex)
        {
            PricingModel = StudioPricingSettings.CreateDefault();
            FormMessage = $"Pricing gagal dibaca. Default dipakai sementara: {ex.Message}";
        }
    }

    private async Task LoadProfileSettingsAsync()
    {
        try
        {
            var json = await JsRuntime.InvokeAsync<string?>("localStorage.getItem", LocalStudioProfileStorageKey);

            ProfileModel = string.IsNullOrWhiteSpace(json)
                ? StudioProfileSettings.CreateDefault()
                : JsonSerializer.Deserialize<StudioProfileSettings>(json, LocalJsonOptions)?.Normalize() ?? StudioProfileSettings.CreateDefault();
        }
        catch (Exception ex)
        {
            ProfileModel = StudioProfileSettings.CreateDefault();
            FormMessage = $"Profile studio gagal dibaca. Default dipakai sementara: {ex.Message}";
        }
    }

    private async Task LoadCloudinarySettingsAsync()
    {
        try
        {
            var json = await JsRuntime.InvokeAsync<string?>("localStorage.getItem", LocalCloudinarySettingsKey);

            CloudinarySettings = string.IsNullOrWhiteSpace(json)
                ? StudioCloudinarySettings.CreateDefault()
                : JsonSerializer.Deserialize<StudioCloudinarySettings>(json, LocalJsonOptions)?.Normalize() ?? StudioCloudinarySettings.CreateDefault();
        }
        catch (Exception ex)
        {
            CloudinarySettings = StudioCloudinarySettings.CreateDefault();
            FormMessage = $"Cloudinary settings gagal dibaca. Default dipakai sementara: {ex.Message}";
        }
    }

    private async Task SaveCurrentSubPageAsync()
    {
        if (ActiveSubPage == SettingsSubPageProfile)
        {
            await SaveProfileSettingsAsync();
            return;
        }

        if (ActiveSubPage == SettingsSubPageGallery)
        {
            await SaveCloudinarySettingsAsync();
            return;
        }

        await SavePricingSettingsAsync();
    }

    private async Task SavePricingSettingsAsync()
    {
        try
        {
            PricingModel = PricingModel.Normalize();

            var json = JsonSerializer.Serialize(PricingModel, LocalJsonOptions);
            await JsRuntime.InvokeVoidAsync("localStorage.setItem", LocalPricingStorageKey, json);

            FormMessage = "Pricing settings berhasil disimpan lokal.";
        }
        catch (Exception ex)
        {
            FormMessage = $"Gagal menyimpan pricing settings: {ex.Message}";
        }
    }

    private async Task SaveCloudinarySettingsAsync()
    {
        try
        {
            CloudinarySettings = CloudinarySettings.Normalize();

            var json = JsonSerializer.Serialize(CloudinarySettings, LocalJsonOptions);
            await JsRuntime.InvokeVoidAsync("localStorage.setItem", LocalCloudinarySettingsKey, json);

            FormMessage = "Cloudinary settings berhasil disimpan lokal.";
        }
        catch (Exception ex)
        {
            FormMessage = $"Gagal menyimpan Cloudinary settings: {ex.Message}";
        }
    }

    private async Task SaveProfileSettingsAsync()
    {
        try
        {
            ProfileModel = ProfileModel.Normalize();

            var json = JsonSerializer.Serialize(ProfileModel, LocalJsonOptions);
            await JsRuntime.InvokeVoidAsync("localStorage.setItem", LocalStudioProfileStorageKey, json);

            FormMessage = "Profile studio berhasil disimpan lokal.";
        }
        catch (Exception ex)
        {
            FormMessage = $"Gagal menyimpan profile studio: {ex.Message}";
        }
    }

    private async Task ResetCurrentSubPageAsync()
    {
        if (ActiveSubPage == SettingsSubPageProfile)
        {
            ProfileModel = StudioProfileSettings.CreateDefault();
            await SaveProfileSettingsAsync();
            FormMessage = "Profile studio dikembalikan ke default.";
            return;
        }

        if (ActiveSubPage == SettingsSubPageGallery)
        {
            CloudinarySettings = StudioCloudinarySettings.CreateDefault();
            await SaveCloudinarySettingsAsync();
            FormMessage = "Cloudinary settings dikembalikan ke default.";
            return;
        }

        PricingModel = StudioPricingSettings.CreateDefault();
        PackageDraft = new RecordingPackageDraft();
        DiscountDraft = TrainingDiscountDraft.CreateDefault();

        await SavePricingSettingsAsync();
        FormMessage = "Pricing settings dikembalikan ke default.";
    }

    private void OnSubPageChanged(ChangeEventArgs args)
    {
        var nextPage = args.Value?.ToString();

        ActiveSubPage = nextPage switch
        {
            SettingsSubPageProfile => SettingsSubPageProfile,
            SettingsSubPageGallery => SettingsSubPageGallery,
            _ => SettingsSubPagePricing
        };

        FormMessage = null;
    }

    private void AddRecordingPackage()
    {
        if (string.IsNullOrWhiteSpace(PackageDraft.Name))
        {
            FormMessage = "Nama paket recording wajib diisi.";
            return;
        }

        if (PackageDraft.DurationHours < 1)
        {
            FormMessage = "Durasi paket minimal 1 jam.";
            return;
        }

        if (PackageDraft.Price < 0)
        {
            FormMessage = "Harga paket tidak boleh minus.";
            return;
        }

        PricingModel.RecordingPackages.Add(new StudioRecordingPackage
        {
            Id = Guid.NewGuid().ToString("N"),
            Name = PackageDraft.Name.Trim(),
            DurationHours = PackageDraft.DurationHours,
            Price = PackageDraft.Price
        });

        PackageDraft = new RecordingPackageDraft();
        FormMessage = "Paket recording ditambahkan. Klik Simpan Settings untuk menyimpan.";
    }

    private void RemoveRecordingPackage(string id)
    {
        PricingModel.RecordingPackages.RemoveAll(item => item.Id == id);
        FormMessage = "Paket recording dihapus. Klik Simpan Settings untuk menyimpan.";
    }

    private void AddTrainingDiscount()
    {
        if (DiscountDraft.DurationHours < 1)
        {
            FormMessage = "Durasi diskon minimal 1 jam.";
            return;
        }

        if (DiscountDraft.Amount < 0)
        {
            FormMessage = "Nominal diskon tidak boleh minus.";
            return;
        }

        PricingModel.TrainingDiscounts.Add(new StudioTrainingDiscount
        {
            Id = Guid.NewGuid().ToString("N"),
            DurationHours = DiscountDraft.DurationHours,
            Amount = DiscountDraft.Amount,
            AppliesMultiple = DiscountDraft.AppliesMultiple
        });

        DiscountDraft = TrainingDiscountDraft.CreateDefault();
        FormMessage = "Diskon latihan ditambahkan. Klik Simpan Settings untuk menyimpan.";
    }

    private void RemoveTrainingDiscount(string id)
    {
        PricingModel.TrainingDiscounts.RemoveAll(item => item.Id == id);
        FormMessage = "Diskon latihan dihapus. Klik Simpan Settings untuk menyimpan.";
    }

    private static string FormatCurrency(decimal value)
    {
        return value <= 0
            ? "Rp0"
            : value.ToString("C0", IndonesianCulture);
    }

    private sealed class RecordingPackageDraft
    {
        public string Name { get; set; } = string.Empty;

        public int DurationHours { get; set; } = 1;

        public decimal Price { get; set; }
    }

    private sealed class TrainingDiscountDraft
    {
        public int DurationHours { get; set; }

        public decimal Amount { get; set; }

        public bool AppliesMultiple { get; set; }

        public static TrainingDiscountDraft CreateDefault()
        {
            return new TrainingDiscountDraft
            {
                DurationHours = 3,
                Amount = 60000,
                AppliesMultiple = true
            };
        }
    }

    private sealed class StudioCloudinarySettings
    {
        public int SchemaVersion { get; set; } = 1;

        public string CloudName { get; set; } = string.Empty;

        public string UploadPreset { get; set; } = string.Empty;

        public string Folder { get; set; } = "37-music-studio/gallery";

        public static StudioCloudinarySettings CreateDefault()
        {
            return new StudioCloudinarySettings
            {
                SchemaVersion = 1,
                CloudName = string.Empty,
                UploadPreset = string.Empty,
                Folder = "37-music-studio/gallery"
            };
        }

        public StudioCloudinarySettings Normalize()
        {
            SchemaVersion = 1;
            CloudName = CloudName?.Trim() ?? string.Empty;
            UploadPreset = UploadPreset?.Trim() ?? string.Empty;
            Folder = string.IsNullOrWhiteSpace(Folder) ? "37-music-studio/gallery" : Folder.Trim();

            return this;
        }
    }

    private sealed class StudioProfileSettings
    {
        public int SchemaVersion { get; set; } = 1;

        public string StudioName { get; set; } = "37 Music Studio";

        public string PhoneOrWhatsApp { get; set; } = string.Empty;

        public string Address { get; set; } = string.Empty;

        [JsonIgnore]
        public string SafeStudioName => string.IsNullOrWhiteSpace(StudioName)
            ? "37 Music Studio"
            : StudioName.Trim();

        [JsonIgnore]
        public string SafePhoneOrWhatsApp => string.IsNullOrWhiteSpace(PhoneOrWhatsApp)
            ? "Nomor HP/WA belum diisi"
            : PhoneOrWhatsApp.Trim();

        [JsonIgnore]
        public string SafeAddress => string.IsNullOrWhiteSpace(Address)
            ? "Alamat studio belum diisi"
            : Address.Trim();

        public static StudioProfileSettings CreateDefault()
        {
            return new StudioProfileSettings
            {
                SchemaVersion = 1,
                StudioName = "37 Music Studio",
                PhoneOrWhatsApp = string.Empty,
                Address = string.Empty
            };
        }

        public StudioProfileSettings Normalize()
        {
            SchemaVersion = 1;
            StudioName = string.IsNullOrWhiteSpace(StudioName) ? "37 Music Studio" : StudioName.Trim();
            PhoneOrWhatsApp = PhoneOrWhatsApp?.Trim() ?? string.Empty;
            Address = Address?.Trim() ?? string.Empty;

            return this;
        }
    }

    private sealed class StudioPricingSettings
    {
        public int SchemaVersion { get; set; } = 1;

        public decimal HourlyRate { get; set; } = 120000;

        public List<StudioRecordingPackage> RecordingPackages { get; set; } = new();

        public List<StudioTrainingDiscount> TrainingDiscounts { get; set; } = new();

        public static StudioPricingSettings CreateDefault()
        {
            return new StudioPricingSettings
            {
                SchemaVersion = 1,
                HourlyRate = 120000,
                RecordingPackages = new List<StudioRecordingPackage>(),
                TrainingDiscounts = new List<StudioTrainingDiscount>
                {
                    new StudioTrainingDiscount
                    {
                        Id = Guid.NewGuid().ToString("N"),
                        DurationHours = 3,
                        Amount = 60000,
                        AppliesMultiple = true
                    }
                }
            };
        }

        public StudioPricingSettings Normalize()
        {
            SchemaVersion = 1;

            if (HourlyRate <= 0)
            {
                HourlyRate = 120000;
            }

            RecordingPackages ??= new List<StudioRecordingPackage>();
            TrainingDiscounts ??= new List<StudioTrainingDiscount>();

            foreach (var item in RecordingPackages)
            {
                if (string.IsNullOrWhiteSpace(item.Id))
                {
                    item.Id = Guid.NewGuid().ToString("N");
                }

                item.Name = string.IsNullOrWhiteSpace(item.Name)
                    ? "Paket Recording"
                    : item.Name.Trim();

                item.DurationHours = Math.Max(1, item.DurationHours);
                item.Price = Math.Max(0, item.Price);
            }

            foreach (var item in TrainingDiscounts)
            {
                if (string.IsNullOrWhiteSpace(item.Id))
                {
                    item.Id = Guid.NewGuid().ToString("N");
                }

                item.DurationHours = Math.Max(1, item.DurationHours);
                item.Amount = Math.Max(0, item.Amount);
            }

            if (!TrainingDiscounts.Any())
            {
                TrainingDiscounts.Add(new StudioTrainingDiscount
                {
                    Id = Guid.NewGuid().ToString("N"),
                    DurationHours = 3,
                    Amount = 60000,
                    AppliesMultiple = true
                });
            }

            return this;
        }
    }

    private sealed class StudioRecordingPackage
    {
        public string Id { get; set; } = string.Empty;

        public string Name { get; set; } = string.Empty;

        public int DurationHours { get; set; } = 1;

        public decimal Price { get; set; }
    }

    private sealed class StudioTrainingDiscount
    {
        public string Id { get; set; } = string.Empty;

        public int DurationHours { get; set; } = 3;

        public decimal Amount { get; set; } = 60000;

        public bool AppliesMultiple { get; set; } = true;
    }
}