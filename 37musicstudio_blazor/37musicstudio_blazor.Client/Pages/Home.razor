@page "/"
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager

<PageTitle>37 Music Studio</PageTitle>

<main class="studio-page studio-center theme-container" aria-labelledby="studioEntryTitle">
    <section class="studio-panel w-[min(100%,34rem)] p-5 sm:p-8">
        <div class="studio-brand-tile" aria-hidden="true">37</div>

        <div class="mt-5">
            <p class="studio-kicker">Admin Portal</p>
            <h1 id="studioEntryTitle" class="studio-title-lg">Mengarahkan ke login...</h1>
            <p class="studio-copy mt-3">
                Kalau halaman tidak berpindah otomatis, tekan tombol di bawah.
            </p>
        </div>

        <a class="studio-button mt-5 inline-flex w-full items-center justify-center text-center no-underline" href="/login">Masuk ke Login</a>
    </section>
</main>

@code {
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        NavigationManager.NavigateTo("/login", replace: true);
    }
}