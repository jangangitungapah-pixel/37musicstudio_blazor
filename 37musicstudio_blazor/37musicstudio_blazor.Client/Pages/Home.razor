@page "/"
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager

<PageTitle>37 Music Studio</PageTitle>

<main class="studio-entry theme-container" aria-labelledby="studioEntryTitle">
    <section class="studio-entry__card">
        <div class="studio-entry__mark" aria-hidden="true">37</div>

        <div>
            <p class="studio-entry__eyebrow">Admin Portal</p>
            <h1 id="studioEntryTitle">Mengarahkan ke login...</h1>
            <p>Kalau halaman tidak berpindah otomatis, tekan tombol di bawah.</p>
        </div>

        <a class="studio-entry__button" href="/login">Masuk ke Login</a>
    </section>
</main>

@code {
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        NavigationManager.NavigateTo("/login", replace: true);
    }
}