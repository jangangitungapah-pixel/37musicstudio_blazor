@page "/billing"
@page "/pos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@layout StudioAdminLayout

@using System.Globalization
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.JSInterop

@inject IJSRuntime JsRuntime

<PageTitle>Billing / POS | 37 Music Studio</PageTitle>

<section class="studio-pos-page" aria-labelledby="billingTitle">
    <header class="studio-pos-header">
        <div>
            <p id="billingTitle">Billing / POS</p>
            <h1>Kasir Booking Studio</h1>
        </div>

        <div class="studio-pos-header-actions">
            <button type="button" class="studio-pos-soft-action" @onclick="ReloadBookingsAsync">
                Refresh
            </button>

            <a class="studio-pos-primary-link" href="/schedule">
                Schedule
            </a>
        </div>
    </header>

    <section class="studio-pos-heroes" aria-label="Ringkasan billing">
        <article class="studio-pos-hero hero-pending">
            <span>Pending</span>
            <strong>@PendingCount</strong>
            <small>@FormatCurrency(PendingAmount)</small>
        </article>

        <article class="studio-pos-hero hero-dp">
            <span>DP</span>
            <strong>@DpCount</strong>
            <small>@FormatCurrency(DpRemainingAmount)</small>
        </article>

        <article class="studio-pos-hero hero-paid">
            <span>Lunas</span>
            <strong>@PaidCount</strong>
            <small>@FormatCurrency(PaidAmount)</small>
        </article>
    </section>

    <section class="studio-pos-shell">
        <aside class="studio-pos-list-panel" aria-label="Daftar booking">
            <div class="studio-pos-filter-row">
                <button type="button" class="@GetFilterClass("all")" @onclick='() => SetFilter("all")'>Semua</button>
                <button type="button" class="@GetFilterClass("Pending")" @onclick='() => SetFilter("Pending")'>Pending</button>
                <button type="button" class="@GetFilterClass("Dp")" @onclick='() => SetFilter("Dp")'>DP</button>
                <button type="button" class="@GetFilterClass("Paid")" @onclick='() => SetFilter("Paid")'>Lunas</button>
            </div>

            <label class="studio-pos-search">
                <span>Cari booking</span>
                <input type="search" placeholder="Nama, band, no HP..." @bind="SearchText" @bind:event="oninput" />
            </label>

            <div class="studio-pos-booking-list">
                @if (!HasLoadedLocalBookings)
                {
                    <div class="studio-pos-empty-state">
                        <strong>Memuat data...</strong>
                        <span>Sedang membaca booking lokal.</span>
                    </div>
                }
                else if (!VisibleBookings.Any())
                {
                    <div class="studio-pos-empty-state">
                        <strong>Belum ada booking</strong>
                        <span>Booking dari Schedule akan muncul di sini.</span>
                    </div>
                }
                else
                {
                    @foreach (var booking in VisibleBookings)
                    {
                        <button type="button" class="@GetBookingItemClass(booking)" @onclick="() => SelectBooking(booking.Id)">
                            <span class="studio-pos-booking-status @GetStatusClass(booking.Status)"></span>

                            <strong>@booking.BandName</strong>
                            <em>@booking.CustomerName</em>
                            <small>@BuildBookingTimeLabel(booking)</small>

                            <b>@GetPaymentStatusLabel(booking.Status)</b>
                        </button>
                    }
                }
            </div>
        </aside>

        <section class="studio-pos-checkout-panel" aria-label="Checkout booking">
            @if (SelectedBooking is null)
            {
                <div class="studio-pos-empty-checkout">
                    <StudioIcon Name="wallet-cards" />
                    <strong>Pilih booking</strong>
                    <span>Pilih booking dari daftar untuk mulai proses billing.</span>
                </div>
            }
            else
            {
                <header class="studio-pos-receipt-head">
                    <div>
                        <p>Invoice Lokal</p>
                        <h2>@SelectedBooking.BandName</h2>
                        <span>@SelectedBooking.CustomerName · @SelectedBooking.PhoneNumber</span>
                    </div>

                    <b class="@GetReceiptBadgeClass(SelectedStatus)">
                        @GetPaymentStatusLabel(SelectedStatus)
                    </b>
                </header>

                <div class="studio-pos-meta-grid">
                    <div>
                        <span>Tanggal</span>
                        <strong>@SelectedBooking.BookingDate.ToString("dd MMM yyyy", IndonesianCulture)</strong>
                    </div>

                    <div>
                        <span>Jam</span>
                        <strong>@FormatTimeRange(SelectedBooking.StartAt, SelectedBooking.EndAt)</strong>
                    </div>

                    <div>
                        <span>Durasi</span>
                        <strong>@SelectedBooking.DurationHours Jam</strong>
                    </div>

                    <div>
                        <span>No Invoice</span>
                        <strong>@BuildInvoiceNumber(SelectedBooking)</strong>
                    </div>
                </div>

                <div class="studio-pos-payment-mode" aria-label="Status pembayaran">
                    <button type="button" class="@GetPaymentButtonClass(BookingPaymentStatus.Pending)" @onclick="() => SetSelectedStatus(BookingPaymentStatus.Pending)">
                        Pending
                    </button>

                    <button type="button" class="@GetPaymentButtonClass(BookingPaymentStatus.Dp)" @onclick="() => SetSelectedStatus(BookingPaymentStatus.Dp)">
                        DP
                    </button>

                    <button type="button" class="@GetPaymentButtonClass(BookingPaymentStatus.Paid)" @onclick="() => SetSelectedStatus(BookingPaymentStatus.Paid)">
                        Lunas
                    </button>
                </div>

                <div class="studio-pos-money-grid">
                    <label>
                        <span>Jumlah</span>
                        <input type="number" min="0" step="1000" @bind="SelectedTotalAmount" @bind:event="oninput" />
                    </label>

                    <label>
                        <span>DP</span>
                        <input type="number" min="0" step="1000" disabled="@(SelectedStatus != BookingPaymentStatus.Dp)" @bind="SelectedDpAmount" @bind:event="oninput" />
                    </label>

                    <div>
                        <span>Sisa</span>
                        <strong>@FormatCurrency(SelectedRemainingAmount)</strong>
                    </div>
                </div>

                <label class="studio-pos-note">
                    <span>Catatan Billing</span>
                    <textarea rows="3" placeholder="Catatan pembayaran..." @bind="SelectedNote" @bind:event="oninput"></textarea>
                </label>

                @if (!string.IsNullOrWhiteSpace(FormMessage))
                {
                    <div class="studio-pos-alert" role="alert">@FormMessage</div>
                }

                <footer class="studio-pos-footer">
                    <button type="button" class="studio-pos-soft-action" @onclick="ResetSelectedDraft">
                        Reset
                    </button>

                    <button type="button" class="studio-pos-save-action" @onclick="SaveSelectedBookingAsync">
                        Simpan Billing
                    </button>
                </footer>
            }
        </section>
    </section>
</section>

@code {
    private const string LocalBookingStorageKey = "37musicstudio.bookings.v1";

    private static readonly CultureInfo IndonesianCulture = new("id-ID");
    private static readonly JsonSerializerOptions LocalJsonOptions = CreateLocalJsonOptions();

    private readonly List<StudioBooking> Bookings = new();

    private bool HasLoadedLocalBookings { get; set; }

    private string ActiveFilter { get; set; } = "all";

    private string SearchText { get; set; } = string.Empty;

    private string? SelectedBookingId { get; set; }

    private decimal SelectedTotalAmount { get; set; }

    private decimal SelectedDpAmount { get; set; }

    private BookingPaymentStatus SelectedStatus { get; set; } = BookingPaymentStatus.Pending;

    private string SelectedNote { get; set; } = string.Empty;

    private string? FormMessage { get; set; }

    private StudioBooking? SelectedBooking => Bookings.FirstOrDefault(booking => booking.Id == SelectedBookingId);

    private IEnumerable<StudioBooking> VisibleBookings
    {
        get
        {
            var query = Bookings
                .OrderByDescending(booking => booking.BookingDate)
                .ThenBy(booking => booking.StartAt)
                .AsEnumerable();

            if (ActiveFilter != "all")
            {
                query = query.Where(booking => booking.Status.ToString() == ActiveFilter);
            }

            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                var keyword = SearchText.Trim();

                query = query.Where(booking =>
                    booking.CustomerName.Contains(keyword, StringComparison.OrdinalIgnoreCase) ||
                    booking.BandName.Contains(keyword, StringComparison.OrdinalIgnoreCase) ||
                    booking.PhoneNumber.Contains(keyword, StringComparison.OrdinalIgnoreCase));
            }

            return query.ToArray();
        }
    }

    private int PendingCount => Bookings.Count(booking => booking.Status == BookingPaymentStatus.Pending);

    private int DpCount => Bookings.Count(booking => booking.Status == BookingPaymentStatus.Dp);

    private int PaidCount => Bookings.Count(booking => booking.Status == BookingPaymentStatus.Paid);

    private decimal PendingAmount => Bookings
        .Where(booking => booking.Status == BookingPaymentStatus.Pending)
        .Sum(booking => booking.RemainingAmount);

    private decimal DpRemainingAmount => Bookings
        .Where(booking => booking.Status == BookingPaymentStatus.Dp)
        .Sum(booking => booking.RemainingAmount);

    private decimal PaidAmount => Bookings
        .Where(booking => booking.Status == BookingPaymentStatus.Paid)
        .Sum(booking => booking.TotalAmount);

    private decimal EffectiveDpAmount => SelectedStatus switch
    {
        BookingPaymentStatus.Pending => 0,
        BookingPaymentStatus.Paid => SelectedTotalAmount,
        _ => Math.Min(Math.Max(SelectedDpAmount, 0), SelectedTotalAmount)
    };

    private decimal SelectedRemainingAmount => Math.Max(SelectedTotalAmount - EffectiveDpAmount, 0);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || HasLoadedLocalBookings)
        {
            return;
        }

        await ReloadBookingsAsync();
        StateHasChanged();
    }

    private static JsonSerializerOptions CreateLocalJsonOptions()
    {
        var options = new JsonSerializerOptions(JsonSerializerDefaults.Web)
        {
            WriteIndented = false
        };

        options.Converters.Add(new JsonStringEnumConverter());

        return options;
    }

    private async Task ReloadBookingsAsync()
    {
        FormMessage = null;

        try
        {
            var json = await JsRuntime.InvokeAsync<string?>("localStorage.getItem", LocalBookingStorageKey);
            var records = string.IsNullOrWhiteSpace(json)
                ? new List<StudioBookingLocalRecord>()
                : JsonSerializer.Deserialize<List<StudioBookingLocalRecord>>(json, LocalJsonOptions) ?? new();

            Bookings.Clear();
            Bookings.AddRange(records.Select(record => record.ToBooking()).OrderBy(booking => booking.StartAt));

            HasLoadedLocalBookings = true;

            if (SelectedBookingId is null || Bookings.All(booking => booking.Id != SelectedBookingId))
            {
                SelectBooking(Bookings.FirstOrDefault()?.Id);
            }
            else
            {
                SelectBooking(SelectedBookingId);
            }
        }
        catch (Exception ex)
        {
            HasLoadedLocalBookings = true;
            FormMessage = $"Gagal membaca data booking lokal: {ex.Message}";
        }
    }

    private async Task PersistBookingsAsync()
    {
        var records = Bookings
            .OrderBy(booking => booking.StartAt)
            .Select(StudioBookingLocalRecord.FromBooking)
            .ToList();

        var json = JsonSerializer.Serialize(records, LocalJsonOptions);
        await JsRuntime.InvokeVoidAsync("localStorage.setItem", LocalBookingStorageKey, json);
    }

    private void SetFilter(string filter)
    {
        ActiveFilter = filter;
    }

    private void SelectBooking(string? bookingId)
    {
        SelectedBookingId = bookingId;
        FormMessage = null;
        ResetSelectedDraft();
    }

    private void ResetSelectedDraft()
    {
        if (SelectedBooking is null)
        {
            SelectedTotalAmount = 0;
            SelectedDpAmount = 0;
            SelectedStatus = BookingPaymentStatus.Pending;
            SelectedNote = string.Empty;
            return;
        }

        SelectedTotalAmount = SelectedBooking.TotalAmount;
        SelectedDpAmount = SelectedBooking.DpAmount;
        SelectedStatus = SelectedBooking.Status;
        SelectedNote = SelectedBooking.Note;
    }

    private void SetSelectedStatus(BookingPaymentStatus status)
    {
        SelectedStatus = status;

        if (status == BookingPaymentStatus.Pending)
        {
            SelectedDpAmount = 0;
        }

        if (status == BookingPaymentStatus.Paid)
        {
            SelectedDpAmount = SelectedTotalAmount;
        }
    }

    private async Task SaveSelectedBookingAsync()
    {
        if (SelectedBooking is null)
        {
            FormMessage = "Pilih booking terlebih dahulu.";
            return;
        }

        var index = Bookings.FindIndex(booking => booking.Id == SelectedBooking.Id);

        if (index < 0)
        {
            FormMessage = "Booking tidak ditemukan.";
            return;
        }

        if (SelectedTotalAmount < 0 || SelectedDpAmount < 0)
        {
            FormMessage = "Nominal tidak boleh minus.";
            return;
        }

        var updated = SelectedBooking with
        {
            Status = SelectedStatus,
            TotalAmount = Math.Max(SelectedTotalAmount, 0),
            DpAmount = EffectiveDpAmount,
            RemainingAmount = SelectedRemainingAmount,
            Note = SelectedNote.Trim()
        };

        Bookings[index] = updated;

        try
        {
            await PersistBookingsAsync();
            SelectedBookingId = updated.Id;
            ResetSelectedDraft();
            FormMessage = "Billing berhasil disimpan ke data lokal.";
        }
        catch (Exception ex)
        {
            FormMessage = $"Gagal menyimpan billing lokal: {ex.Message}";
        }
    }

    private string GetFilterClass(string filter)
    {
        return ActiveFilter == filter
            ? "studio-pos-filter is-active"
            : "studio-pos-filter";
    }

    private string GetBookingItemClass(StudioBooking booking)
    {
        return SelectedBookingId == booking.Id
            ? $"studio-pos-booking-item is-active {GetStatusClass(booking.Status)}"
            : $"studio-pos-booking-item {GetStatusClass(booking.Status)}";
    }

    private string GetPaymentButtonClass(BookingPaymentStatus status)
    {
        return SelectedStatus == status
            ? $"studio-pos-payment-button is-active {GetStatusClass(status)}"
            : $"studio-pos-payment-button {GetStatusClass(status)}";
    }

    private static string GetReceiptBadgeClass(BookingPaymentStatus status)
    {
        return $"studio-pos-receipt-badge {GetStatusClass(status)}";
    }

    private static string GetStatusClass(BookingPaymentStatus status)
    {
        return status switch
        {
            BookingPaymentStatus.Pending => "status-pending",
            BookingPaymentStatus.Dp => "status-dp",
            BookingPaymentStatus.Paid => "status-paid",
            _ => "status-pending"
        };
    }

    private static string GetPaymentStatusLabel(BookingPaymentStatus status)
    {
        return status switch
        {
            BookingPaymentStatus.Pending => "Pending",
            BookingPaymentStatus.Dp => "DP",
            BookingPaymentStatus.Paid => "Lunas",
            _ => status.ToString()
        };
    }

    private static string BuildInvoiceNumber(StudioBooking booking)
    {
        var suffix = booking.Id.Length >= 6
            ? booking.Id[..6].ToUpperInvariant()
            : booking.Id.ToUpperInvariant();

        return $"POS-{booking.BookingDate:yyyyMMdd}-{suffix}";
    }

    private static string BuildBookingTimeLabel(StudioBooking booking)
    {
        return $"{booking.BookingDate:dd MMM yyyy} · {FormatTimeRange(booking.StartAt, booking.EndAt)}";
    }

    private static string FormatTimeRange(DateTime startAt, DateTime endAt)
    {
        return $"{FormatTime(startAt.TimeOfDay)} - {FormatTime(endAt.TimeOfDay)}";
    }

    private static string FormatTime(TimeSpan time)
    {
        return $"{(int)time.TotalHours:00}.00";
    }

    private static string FormatCurrency(decimal value)
    {
        return value <= 0
            ? "Rp0"
            : value.ToString("C0", IndonesianCulture);
    }

    private enum BookingPaymentStatus
    {
        Pending,
        Dp,
        Paid
    }

    private readonly record struct ScheduleTimeSlot(TimeSpan Start, TimeSpan End);

    private sealed record StudioBooking(
        string Id,
        string CustomerName,
        string BandName,
        string PhoneNumber,
        DateTime BookingDate,
        DateTime StartAt,
        DateTime EndAt,
        ScheduleTimeSlot Slot,
        string Duration,
        int DurationHours,
        int CustomDurationHours,
        BookingPaymentStatus Status,
        decimal TotalAmount,
        decimal DpAmount,
        decimal RemainingAmount,
        string Note)
    {
        public string DisplayName => string.IsNullOrWhiteSpace(BandName)
            ? CustomerName
            : BandName;
    }

    private sealed class StudioBookingLocalRecord
    {
        public int SchemaVersion { get; set; } = 1;

        public string Id { get; set; } = string.Empty;

        public string CustomerName { get; set; } = string.Empty;

        public string BandName { get; set; } = string.Empty;

        public string PhoneNumber { get; set; } = string.Empty;

        public DateTime BookingDate { get; set; }

        public DateTime StartAt { get; set; }

        public DateTime EndAt { get; set; }

        public int SlotStartHour { get; set; }

        public int SlotEndHour { get; set; }

        public string Duration { get; set; } = "1 Jam";

        public int DurationHours { get; set; } = 1;

        public int CustomDurationHours { get; set; } = 1;

        public BookingPaymentStatus Status { get; set; }

        public decimal TotalAmount { get; set; }

        public decimal DpAmount { get; set; }

        public decimal RemainingAmount { get; set; }

        public string Note { get; set; } = string.Empty;

        public static StudioBookingLocalRecord FromBooking(StudioBooking booking)
        {
            return new StudioBookingLocalRecord
            {
                SchemaVersion = 1,
                Id = booking.Id,
                CustomerName = booking.CustomerName,
                BandName = booking.BandName,
                PhoneNumber = booking.PhoneNumber,
                BookingDate = booking.BookingDate,
                StartAt = booking.StartAt,
                EndAt = booking.EndAt,
                SlotStartHour = (int)booking.Slot.Start.TotalHours,
                SlotEndHour = (int)booking.Slot.End.TotalHours,
                Duration = booking.Duration,
                DurationHours = booking.DurationHours,
                CustomDurationHours = booking.CustomDurationHours,
                Status = booking.Status,
                TotalAmount = booking.TotalAmount,
                DpAmount = booking.DpAmount,
                RemainingAmount = booking.RemainingAmount,
                Note = booking.Note
            };
        }

        public StudioBooking ToBooking()
        {
            var safeId = string.IsNullOrWhiteSpace(Id)
                ? Guid.NewGuid().ToString("N")
                : Id;

            var safeDurationHours = Math.Max(1, DurationHours);
            var safeSlotStart = SlotStartHour <= 0
                ? StartAt.Hour
                : SlotStartHour;

            var safeSlotEnd = SlotEndHour <= safeSlotStart
                ? safeSlotStart + 1
                : SlotEndHour;

            return new StudioBooking(
                safeId,
                CustomerName.Trim(),
                BandName.Trim(),
                PhoneNumber.Trim(),
                BookingDate.Date,
                StartAt,
                EndAt,
                new ScheduleTimeSlot(TimeSpan.FromHours(safeSlotStart), TimeSpan.FromHours(safeSlotEnd)),
                string.IsNullOrWhiteSpace(Duration) ? $"{safeDurationHours} Jam" : Duration,
                safeDurationHours,
                Math.Max(1, CustomDurationHours),
                Status,
                TotalAmount,
                DpAmount,
                RemainingAmount,
                Note.Trim()
            );
        }
    }
}