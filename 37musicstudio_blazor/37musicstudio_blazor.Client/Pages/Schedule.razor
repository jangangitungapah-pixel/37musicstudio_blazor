@page "/"
@page "/admin"
@page "/schedule"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@layout StudioAdminLayout
@rendermode InteractiveAuto

@using System.Globalization
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.JSInterop

@inject IJSRuntime JsRuntime

<PageTitle>Schedule | 37 Music Studio</PageTitle>

<section class="studio-schedule-page" aria-labelledby="scheduleTitle">
    <header class="studio-schedule-toolbar">
        <div class="studio-toolbar-main">
            <div class="studio-toolbar-title">
                <p id="scheduleTitle">Kalender Booking</p>
                <h1>@CalendarTitle</h1>
            </div>

            <div class="studio-toolbar-actions" aria-label="Kontrol kalender">
                <button class="studio-nav-icon" type="button" @onclick="GoToPreviousRange" aria-label="Sebelumnya">
                    <span aria-hidden="true">&#8249;</span>
                </button>

                <button class="studio-today-action" type="button" @onclick="GoToCurrentRange">
                    Hari Ini
                </button>

                <button class="studio-nav-icon" type="button" @onclick="GoToNextRange" aria-label="Berikutnya">
                    <span aria-hidden="true">&#8250;</span>
                </button>
            </div>
        </div>

        <div class="studio-toolbar-rail" aria-label="Quick view dan quick filter">
            <div class="studio-control-group" aria-label="Quick view mode">
                <span class="studio-control-label">View</span>

                <button type="button" class="@GetViewModeButtonClass(ScheduleViewMode.Day)" @onclick="() => SetViewMode(ScheduleViewMode.Day)">
                    Hari
                </button>

                <button type="button" class="@GetViewModeButtonClass(ScheduleViewMode.Week)" @onclick="() => SetViewMode(ScheduleViewMode.Week)">
                    Minggu
                </button>

                <button type="button" class="@GetViewModeButtonClass(ScheduleViewMode.Month)" @onclick="() => SetViewMode(ScheduleViewMode.Month)">
                    Bulan
                </button>
            </div>

            <div class="studio-control-group studio-filter-group" aria-label="Quick filter booking">
                <span class="studio-control-label">Filter</span>

                <button type="button" class="@GetStatusFilterButtonClass(null)" @onclick="() => SetStatusFilter(null)">
                    <span class="studio-status-dot"></span>
                    Semua
                </button>

                <button type="button" class="@GetStatusFilterButtonClass(BookingPaymentStatus.Pending)" @onclick="() => SetStatusFilter(BookingPaymentStatus.Pending)">
                    <span class="studio-status-dot"></span>
                    Pending
                </button>

                <button type="button" class="@GetStatusFilterButtonClass(BookingPaymentStatus.Dp)" @onclick="() => SetStatusFilter(BookingPaymentStatus.Dp)">
                    <span class="studio-status-dot"></span>
                    DP
                </button>

                <button type="button" class="@GetStatusFilterButtonClass(BookingPaymentStatus.Paid)" @onclick="() => SetStatusFilter(BookingPaymentStatus.Paid)">
                    <span class="studio-status-dot"></span>
                    Lunas
                </button>
            </div>
        </div>
    
        <div class="studio-schedule-hero-strip" aria-label="Ringkasan status booking">
            <article class="studio-status-hero hero-pending">
                <span>Pending</span>
                <strong>@PendingBookingCount</strong>
                <small>Menunggu konfirmasi</small>
            </article>

            <article class="studio-status-hero hero-dp">
                <span>DP</span>
                <strong>@DpBookingCount</strong>
                <small>Sudah bayar tanda jadi</small>
            </article>

            <article class="studio-status-hero hero-paid">
                <span>Lunas</span>
                <strong>@PaidBookingCount</strong>
                <small>Pembayaran selesai</small>
            </article>
        </div>
    </header>

    <section class="studio-schedule-board" style="@ScheduleDayStyle" aria-label="Grid jadwal">
        <div class="studio-schedule-table-wrap">
            <table class="studio-schedule-table">
                <thead>
                    <tr>
                        <th class="studio-schedule-time-head" scope="col">Jam</th>

                        @foreach (var day in VisibleDays)
                        {
                            <th class="@GetDayHeaderClass(day)" scope="col">
                                <span>@GetDayName(day)</span>
                                <strong>@day.Day</strong>
                            </th>
                        }
                    </tr>
                </thead>

                <tbody>
                    @foreach (var slot in TimeSlots)
                    {
                        <tr>
                            <th class="studio-schedule-time-cell" scope="row">
                                <span>@FormatTimeSlot(slot)</span>
                            </th>

                            @foreach (var day in VisibleDays)
                            {
                                var segment = GetBookingSegment(day, slot);

                                if (segment is not null && !segment.IsStart)
                                {
                                    continue;
                                }

                                var booking = segment?.Booking;
                                var cellId = BuildCellId(day, slot);
                                var isToday = day.Date == Today.Date;
                                var isSelected = SelectedSlotId == cellId;
                                var isFilteredOut = ActiveStatusFilter is not null && booking is not null && booking.Status != ActiveStatusFilter.Value;

                                if (segment is null)
                                {
                                    <td class="@GetEmptyCellClass(isToday, isSelected)">
                                        <button
                                            type="button"
                                            class="studio-schedule-slot is-empty"
                                            title="@BuildSlotTitle(day, slot)"
                                            aria-label="@BuildSlotAria(day, slot)"
                                            @onclick="() => OpenBookingCanvas(day, slot, null)">
                                            <span class="studio-empty-slot-indicator">
                                                <StudioIcon Name="plus" />
                                            </span>
                                        </button>
                                    </td>
                                }
                                else
                                {
                                    <td
                                        class="@GetBookingCellClass(isToday, isSelected, segment, isFilteredOut)"
                                        rowspan="@GetBookingRowSpan(segment.Booking)"
                                        style="@BuildBookingBlockStyle(segment.Booking)">
                                        <button
                                            type="button"
                                            class="@GetSlotButtonClass(segment, isFilteredOut)"
                                            title="@BuildBookingTitle(segment.Booking)"
                                            aria-label="@BuildBookingAria(segment.Booking)"
                                            @onclick="() => OpenBookingCanvas(day, slot, segment.Booking)">
                                            <span class="studio-booking-block">
                                                <strong>@segment.Booking.BandName</strong>
                                                <b>@GetPaymentStatusLabel(segment.Booking.Status)</b>
                                            </span>
                                        </button>
                                    </td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @if (IsBookingCanvasOpen)
    {
        <div class="studio-booking-modal" role="dialog" aria-modal="true" aria-labelledby="bookingCanvasTitle">
            <button class="studio-booking-backdrop" type="button" aria-label="Tutup modal booking" @onclick="CloseBookingCanvas"></button>

            <section class="studio-booking-panel studio-booking-form-panel">
                <header class="studio-booking-header">
                    <div>
                        <p id="bookingCanvasTitle">Booking Form</p>
                        <h2>@SelectedSlotTitle</h2>
                    </div>

                    <button type="button" aria-label="Tutup modal booking" @onclick="CloseBookingCanvas">
                        Close
                    </button>
                </header>

                <form class="studio-booking-form" @onsubmit="SaveBooking" @onsubmit:preventDefault>
                    @if (!string.IsNullOrWhiteSpace(FormMessage))
                    {
                        <div class="studio-booking-form-alert" role="alert">@FormMessage</div>
                    }

                    <div class="studio-booking-form-grid">
                        <label class="studio-form-field">
                            <span>Nama</span>
                            <input type="text" autocomplete="name" placeholder="Nama customer" required @bind="CustomerName" @bind:event="oninput" />
                        </label>

                        <label class="studio-form-field">
                            <span>Nama Band</span>
                            <input type="text" placeholder="Nama band" required @bind="BandName" @bind:event="oninput" />
                        </label>

                        <label class="studio-form-field">
                            <span>No Hp</span>
                            <input type="tel" inputmode="tel" autocomplete="tel" placeholder="08xxxxxxxxxx" required @bind="PhoneNumber" @bind:event="oninput" />
                        </label>

                        <label class="studio-form-field">
                            <span>Tanggal Booking</span>
                            <input type="date" required @bind="BookingDate" />
                        </label>

                        <label class="studio-form-field">
                            <span>Durasi Booking</span>
                            <select required @bind="BookingDuration">
                                <option value="1 Jam">1 Jam</option>
                                <option value="2 Jam">2 Jam</option>
                                <option value="3 Jam">3 Jam</option>
                                <option value="4 Jam">4 Jam</option>
                                <option value="5 Jam">5 Jam</option>
                                <option value="6 Jam">6 Jam</option>
                                <option value="Custom">Custom</option>
                            </select>
                        </label>

                        @if (BookingDuration == "Custom")
                        {
                            <label class="studio-form-field">
                                <span>Custom Jam</span>
                                <input type="number" min="1" max="12" step="1" required @bind="CustomDurationHours" @bind:event="oninput" />
                            </label>
                        }

                        <label class="studio-form-field">
                            <span>Status Pembayaran</span>
                            <select required @bind="PaymentStatus">
                                <option value="Pending">Pending</option>
                                <option value="Dp">DP</option>
                                <option value="Paid">Lunas</option>
                            </select>
                        </label>
                    </div>

                    <div class="studio-booking-detail" aria-label="Detail pembayaran">
                        <label class="studio-detail-box">
                            <span>Jumlah</span>
                            <input type="number" min="0" step="1000" placeholder="0" @bind="TotalAmount" @bind:event="oninput" />
                        </label>

                        <div class="studio-detail-box">
                            <span>DP</span>

                            @if (PaymentStatus == BookingPaymentStatus.Dp)
                            {
                                <input type="number" min="0" step="1000" placeholder="0" @bind="DpAmount" @bind:event="oninput" />
                            }
                            else
                            {
                                <strong>@FormatCurrency(EffectiveDpAmount)</strong>
                            }
                        </div>

                        <div class="studio-detail-box is-readonly">
                            <span>Sisa</span>
                            <strong>@FormatCurrency(RemainingAmount)</strong>
                        </div>
                    </div>

                    <label class="studio-form-field studio-field-full">
                        <span>Catatan <small>Opsional</small></span>
                        <textarea rows="3" placeholder="Catatan tambahan..." @bind="Note" @bind:event="oninput"></textarea>
                    </label>

                    <footer class="studio-booking-form-footer">
                        <button class="studio-form-secondary" type="button" @onclick="CloseBookingCanvas">
                            Batal
                        </button>

                        <button class="studio-form-primary" type="submit">
                            Simpan Booking
                        </button>
                    </footer>
                </form>
            </section>
        </div>
    }
</section>

@code {
    private const int StudioOpenHour = 10;
    private const int StudioCloseHour = 23;
    private const string LocalBookingStorageKey = "37musicstudio.bookings.v1";

    private static readonly CultureInfo IndonesianCulture = new("id-ID");
    private static readonly JsonSerializerOptions LocalJsonOptions = CreateLocalJsonOptions();

    private readonly List<StudioBooking> Bookings = new();

    private DateTime CurrentAnchorDate { get; set; } = DateTime.Today;

    private ScheduleViewMode ActiveViewMode { get; set; } = ScheduleViewMode.Month;

    private BookingPaymentStatus? ActiveStatusFilter { get; set; }

    private DateTime Today => DateTime.Today;

    private IReadOnlyList<DateTime> VisibleDays => ActiveViewMode switch
    {
        ScheduleViewMode.Day => new[] { CurrentAnchorDate.Date },
        ScheduleViewMode.Week => Enumerable.Range(0, 7).Select(offset => StartOfWeek(CurrentAnchorDate).AddDays(offset)).ToArray(),
        _ => Enumerable
            .Range(1, DateTime.DaysInMonth(CurrentAnchorDate.Year, CurrentAnchorDate.Month))
            .Select(day => new DateTime(CurrentAnchorDate.Year, CurrentAnchorDate.Month, day))
            .ToArray()
    };

    private IReadOnlyList<ScheduleTimeSlot> TimeSlots { get; } = Enumerable
        .Range(StudioOpenHour, StudioCloseHour - StudioOpenHour)
        .Select(hour => new ScheduleTimeSlot(TimeSpan.FromHours(hour), TimeSpan.FromHours(hour + 1)))
        .ToArray();

    private bool IsBookingCanvasOpen { get; set; }

    private bool HasLoadedLocalBookings { get; set; }

    private DateTime? SelectedDate { get; set; }

    private ScheduleTimeSlot? SelectedSlot { get; set; }

    private string? SelectedSlotId { get; set; }

    private string? EditingBookingId { get; set; }

    private string CustomerName { get; set; } = string.Empty;

    private string BandName { get; set; } = string.Empty;

    private string PhoneNumber { get; set; } = string.Empty;

    private DateTime BookingDate { get; set; } = DateTime.Today;

    private string BookingDuration { get; set; } = "1 Jam";

    private int CustomDurationHours { get; set; } = 1;

    private BookingPaymentStatus PaymentStatus { get; set; } = BookingPaymentStatus.Pending;

    private decimal TotalAmount { get; set; }

    private decimal DpAmount { get; set; }

    private string Note { get; set; } = string.Empty;

    private string? FormMessage { get; set; }

    private int EffectiveDurationHours
    {
        get
        {
            if (BookingDuration == "Custom")
            {
                return Math.Max(1, CustomDurationHours);
            }

            var firstPart = BookingDuration.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();

            return int.TryParse(firstPart, out var hours)
                ? Math.Max(1, hours)
                : 1;
        }
    }

    private DateTime? DraftStartAt => SelectedSlot is null
        ? null
        : BookingDate.Date.Add(SelectedSlot.Value.Start);

    private DateTime? DraftEndAt => DraftStartAt?.AddHours(EffectiveDurationHours);

    private string CalendarTitle => ActiveViewMode switch
    {
        ScheduleViewMode.Day => CurrentAnchorDate.ToString("dddd, dd MMMM yyyy", IndonesianCulture),
        ScheduleViewMode.Week => BuildWeekTitle(),
        _ => CurrentAnchorDate.ToString("MMMM yyyy", IndonesianCulture)
    };

    private string ScheduleDayStyle => $"--schedule-days:{VisibleDays.Count};";

    private decimal EffectiveDpAmount => PaymentStatus switch
    {
        BookingPaymentStatus.Paid => TotalAmount,
        BookingPaymentStatus.Pending => 0,
        _ => Math.Min(Math.Max(DpAmount, 0), TotalAmount)
    };

    private decimal RemainingAmount => Math.Max(TotalAmount - EffectiveDpAmount, 0);

    private string SelectedSlotTitle
    {
        get
        {
            if (SelectedSlot is null || DraftStartAt is null || DraftEndAt is null)
            {
                return string.Empty;
            }

            return $"{BookingDate.ToString("dddd, dd MMMM yyyy", IndonesianCulture)} - {FormatTime(DraftStartAt.Value.TimeOfDay)} - {FormatTime(DraftEndAt.Value.TimeOfDay)}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || HasLoadedLocalBookings)
        {
            return;
        }

        HasLoadedLocalBookings = true;
        await LoadBookingsFromLocalStorageAsync();
        StateHasChanged();
    }

    private static JsonSerializerOptions CreateLocalJsonOptions()
    {
        var options = new JsonSerializerOptions(JsonSerializerDefaults.Web)
        {
            WriteIndented = false
        };

        options.Converters.Add(new JsonStringEnumConverter());

        return options;
    }

    private async Task LoadBookingsFromLocalStorageAsync()
    {
        try
        {
            var json = await JsRuntime.InvokeAsync<string?>("localStorage.getItem", LocalBookingStorageKey);

            if (string.IsNullOrWhiteSpace(json))
            {
                return;
            }

            var localRecords = JsonSerializer.Deserialize<List<StudioBookingLocalRecord>>(json, LocalJsonOptions) ?? new();

            Bookings.Clear();

            foreach (var record in localRecords.OrderBy(item => item.StartAt))
            {
                var booking = record.ToBooking();

                if (booking.StartAt >= booking.EndAt)
                {
                    continue;
                }

                if (HasBookingConflict(booking.StartAt, booking.EndAt, booking.Id))
                {
                    continue;
                }

                Bookings.Add(booking);
            }
        }
        catch
        {
            Bookings.Clear();
        }
    }

    private async Task<bool> PersistBookingsToLocalStorageAsync()
    {
        try
        {
            var localRecords = Bookings
                .OrderBy(booking => booking.StartAt)
                .Select(StudioBookingLocalRecord.FromBooking)
                .ToList();

            var json = JsonSerializer.Serialize(localRecords, LocalJsonOptions);
            await JsRuntime.InvokeVoidAsync("localStorage.setItem", LocalBookingStorageKey, json);

            return true;
        }
        catch (Exception ex)
        {
            FormMessage = $"Data booking tampil sementara, tapi gagal disimpan lokal: {ex.Message}";
            return false;
        }
    }


    private IReadOnlyList<StudioBooking> VisibleRangeBookings
    {
        get
        {
            var days = VisibleDays;

            if (days.Count == 0)
            {
                return Array.Empty<StudioBooking>();
            }

            var start = days.First().Date;
            var end = days.Last().Date.AddDays(1);

            return Bookings
                .Where(booking => booking.StartAt < end && booking.EndAt > start)
                .OrderBy(booking => booking.StartAt)
                .ToArray();
        }
    }

    private int PendingBookingCount => CountVisibleBookingsByStatus(BookingPaymentStatus.Pending);

    private int DpBookingCount => CountVisibleBookingsByStatus(BookingPaymentStatus.Dp);

    private int PaidBookingCount => CountVisibleBookingsByStatus(BookingPaymentStatus.Paid);

    private int CountVisibleBookingsByStatus(BookingPaymentStatus status)
    {
        return VisibleRangeBookings.Count(booking => booking.Status == status);
    }
    private void SetViewMode(ScheduleViewMode viewMode)
    {
        ActiveViewMode = viewMode;
        CurrentAnchorDate = viewMode == ScheduleViewMode.Month
            ? new DateTime(CurrentAnchorDate.Year, CurrentAnchorDate.Month, 1)
            : CurrentAnchorDate.Date;

        CloseBookingCanvas();
    }

    private void SetStatusFilter(BookingPaymentStatus? statusFilter)
    {
        ActiveStatusFilter = statusFilter;
        CloseBookingCanvas();
    }

    private void GoToPreviousRange()
    {
        CurrentAnchorDate = ActiveViewMode switch
        {
            ScheduleViewMode.Day => CurrentAnchorDate.AddDays(-1),
            ScheduleViewMode.Week => CurrentAnchorDate.AddDays(-7),
            _ => CurrentAnchorDate.AddMonths(-1)
        };

        CloseBookingCanvas();
    }

    private void GoToNextRange()
    {
        CurrentAnchorDate = ActiveViewMode switch
        {
            ScheduleViewMode.Day => CurrentAnchorDate.AddDays(1),
            ScheduleViewMode.Week => CurrentAnchorDate.AddDays(7),
            _ => CurrentAnchorDate.AddMonths(1)
        };

        CloseBookingCanvas();
    }

    private void GoToCurrentRange()
    {
        CurrentAnchorDate = ActiveViewMode == ScheduleViewMode.Month
            ? new DateTime(Today.Year, Today.Month, 1)
            : Today.Date;

        CloseBookingCanvas();
    }

    private void OpenBookingCanvas(DateTime date, ScheduleTimeSlot slot, StudioBooking? booking)
    {
        FormMessage = null;

        if (booking is not null)
        {
            LoadBookingIntoForm(booking);
            return;
        }

        EditingBookingId = null;
        SelectedDate = date.Date;
        SelectedSlot = slot;
        SelectedSlotId = BuildCellId(date, slot);
        BookingDate = date.Date;
        ResetBookingFormFields();
        IsBookingCanvasOpen = true;
    }

    private void LoadBookingIntoForm(StudioBooking booking)
    {
        EditingBookingId = booking.Id;
        SelectedDate = booking.BookingDate.Date;
        SelectedSlot = booking.Slot;
        SelectedSlotId = BuildCellId(booking.BookingDate, booking.Slot);

        CustomerName = booking.CustomerName;
        BandName = booking.BandName;
        PhoneNumber = booking.PhoneNumber;
        BookingDate = booking.BookingDate.Date;
        BookingDuration = booking.Duration;
        CustomDurationHours = booking.CustomDurationHours;
        PaymentStatus = booking.Status;
        TotalAmount = booking.TotalAmount;
        DpAmount = booking.DpAmount;
        Note = booking.Note;

        IsBookingCanvasOpen = true;
    }

    private void ResetBookingFormFields()
    {
        CustomerName = string.Empty;
        BandName = string.Empty;
        PhoneNumber = string.Empty;
        BookingDuration = "1 Jam";
        CustomDurationHours = 1;
        PaymentStatus = BookingPaymentStatus.Pending;
        TotalAmount = 0;
        DpAmount = 0;
        Note = string.Empty;
    }

    private void CloseBookingCanvas()
    {
        IsBookingCanvasOpen = false;
        SelectedDate = null;
        SelectedSlot = null;
        SelectedSlotId = null;
        EditingBookingId = null;
        FormMessage = null;
    }

    private async Task SaveBooking()
    {
        if (SelectedSlot is null || DraftStartAt is null || DraftEndAt is null)
        {
            FormMessage = "Slot booking belum dipilih.";
            return;
        }

        if (string.IsNullOrWhiteSpace(CustomerName) ||
            string.IsNullOrWhiteSpace(BandName) ||
            string.IsNullOrWhiteSpace(PhoneNumber))
        {
            FormMessage = "Nama, nama band, dan nomor HP wajib diisi.";
            return;
        }

        if (BookingDuration == "Custom" && CustomDurationHours < 1)
        {
            FormMessage = "Durasi custom minimal 1 jam.";
            return;
        }

        var startAt = DraftStartAt.Value;
        var endAt = DraftEndAt.Value;
        var openAt = BookingDate.Date.AddHours(StudioOpenHour);
        var closeAt = BookingDate.Date.AddHours(StudioCloseHour);

        if (startAt < openAt || endAt > closeAt)
        {
            FormMessage = $"Durasi melewati jam operasional studio ({FormatTime(openAt.TimeOfDay)} - {FormatTime(closeAt.TimeOfDay)}).";
            return;
        }

        if (HasBookingConflict(startAt, endAt, EditingBookingId))
        {
            FormMessage = "Slot ini bentrok dengan booking lain. Pilih jam atau durasi berbeda.";
            return;
        }

        var snapshot = Bookings.ToList();
        var bookingId = EditingBookingId ?? Guid.NewGuid().ToString("N");
        var oldBooking = Bookings.FirstOrDefault(booking => booking.Id == bookingId);

        if (oldBooking is not null)
        {
            Bookings.Remove(oldBooking);
        }

        Bookings.Add(new StudioBooking(
            bookingId,
            CustomerName.Trim(),
            BandName.Trim(),
            PhoneNumber.Trim(),
            BookingDate.Date,
            startAt,
            endAt,
            SelectedSlot.Value,
            BookingDuration,
            EffectiveDurationHours,
            CustomDurationHours,
            PaymentStatus,
            TotalAmount,
            EffectiveDpAmount,
            RemainingAmount,
            Note.Trim()
        ));

        var persisted = await PersistBookingsToLocalStorageAsync();

        if (!persisted)
        {
            Bookings.Clear();
            Bookings.AddRange(snapshot);
            return;
        }

        CurrentAnchorDate = ActiveViewMode == ScheduleViewMode.Month
            ? new DateTime(BookingDate.Year, BookingDate.Month, 1)
            : BookingDate.Date;

        CloseBookingCanvas();
    }

    private bool HasBookingConflict(DateTime startAt, DateTime endAt, string? ignoredBookingId)
    {
        return Bookings.Any(booking =>
            booking.Id != ignoredBookingId &&
            startAt < booking.EndAt &&
            endAt > booking.StartAt);
    }

    private StudioBookingSegment? GetBookingSegment(DateTime day, ScheduleTimeSlot slot)
    {
        var slotStartAt = day.Date.Add(slot.Start);
        var slotEndAt = day.Date.Add(slot.End);

        var booking = Bookings.FirstOrDefault(item =>
            slotStartAt < item.EndAt &&
            slotEndAt > item.StartAt);

        if (booking is null)
        {
            return null;
        }

        return new StudioBookingSegment(
            booking,
            slotStartAt == booking.StartAt,
            slotEndAt >= booking.EndAt
        );
    }

    private int GetBookingRowSpan(StudioBooking booking)
    {
        var firstSlotIndex = TimeSlots.ToList().FindIndex(slot => BookingDateTimeMatchesSlot(booking.StartAt, slot));
        var maxSlots = firstSlotIndex >= 0
            ? TimeSlots.Count - firstSlotIndex
            : booking.DurationHours;

        return Math.Clamp(booking.DurationHours, 1, Math.Max(1, maxSlots));
    }

    private static bool BookingDateTimeMatchesSlot(DateTime startAt, ScheduleTimeSlot slot)
    {
        return startAt.TimeOfDay == slot.Start;
    }

    private string GetViewModeButtonClass(ScheduleViewMode viewMode)
    {
        return ActiveViewMode == viewMode
            ? "studio-control-button is-active"
            : "studio-control-button";
    }

    private string GetStatusFilterButtonClass(BookingPaymentStatus? statusFilter)
    {
        var key = statusFilter is null
            ? "all"
            : statusFilter.Value.ToString().ToLowerInvariant();

        return ActiveStatusFilter == statusFilter
            ? $"studio-control-button studio-status-{key} is-active"
            : $"studio-control-button studio-status-{key}";
    }

    private static string GetPaymentStatusLabel(BookingPaymentStatus status)
    {
        return status switch
        {
            BookingPaymentStatus.Pending => "Pending",
            BookingPaymentStatus.Dp => "DP",
            BookingPaymentStatus.Paid => "Lunas",
            _ => status.ToString()
        };
    }

    private static string BuildBookingChipMeta(StudioBooking booking)
    {
        return $"{FormatTime(booking.StartAt.TimeOfDay)} - {FormatTime(booking.EndAt.TimeOfDay)} | {booking.DurationHours} Jam";
    }

    private static string BuildBookingBlockStyle(StudioBooking booking)
    {
        return $"--booking-hours:{Math.Max(1, booking.DurationHours)};";
    }

    private static string BuildBookingTitle(StudioBooking booking)
    {
        return $"{booking.DisplayName} | {FormatTime(booking.StartAt.TimeOfDay)} - {FormatTime(booking.EndAt.TimeOfDay)} | {GetPaymentStatusLabel(booking.Status)}";
    }

    private static string BuildBookingAria(StudioBooking booking)
    {
        return $"Buka booking {BuildBookingTitle(booking)}";
    }

    private static string GetSlotButtonClass(StudioBookingSegment? segment, bool isFilteredOut)
    {
        if (segment is null)
        {
            return "studio-schedule-slot is-empty";
        }

        var statusKey = segment.Booking.Status.ToString().ToLowerInvariant();
        var durationKey = Math.Clamp(segment.Booking.DurationHours, 1, 6);
        var className = $"studio-schedule-slot has-booking status-{statusKey} duration-{durationKey}";

        if (isFilteredOut)
        {
            className += " is-filtered-out";
        }

        return className;
    }

    private static string GetEmptyCellClass(bool isToday, bool isSelected)
    {
        var className = "studio-schedule-cell";

        if (isToday)
        {
            className += " is-today";
        }

        if (isSelected)
        {
            className += " is-selected";
        }

        return className;
    }

    private static string GetBookingCellClass(bool isToday, bool isSelected, StudioBookingSegment segment, bool isFilteredOut)
    {
        var className = "studio-schedule-cell has-booking is-rowspan-booking";

        if (isToday)
        {
            className += " is-today";
        }

        if (isSelected)
        {
            className += " is-selected";
        }

        if (isFilteredOut)
        {
            className += " is-filtered-out";
        }

        return className;
    }

    private string BuildWeekTitle()
    {
        var start = StartOfWeek(CurrentAnchorDate);
        var end = start.AddDays(6);

        if (start.Year == end.Year && start.Month == end.Month)
        {
            return $"{start.ToString("dd", IndonesianCulture)} - {end.ToString("dd MMMM yyyy", IndonesianCulture)}";
        }

        if (start.Year == end.Year)
        {
            return $"{start.ToString("dd MMM", IndonesianCulture)} - {end.ToString("dd MMMM yyyy", IndonesianCulture)}";
        }

        return $"{start.ToString("dd MMM yyyy", IndonesianCulture)} - {end.ToString("dd MMM yyyy", IndonesianCulture)}";
    }

    private static DateTime StartOfWeek(DateTime date)
    {
        var diff = ((int)date.DayOfWeek - (int)DayOfWeek.Monday + 7) % 7;
        return date.Date.AddDays(-diff);
    }

    private static string BuildCellId(DateTime day, ScheduleTimeSlot slot)
    {
        return $"{day:yyyyMMdd}-{(int)slot.Start.TotalHours:00}";
    }

    private static string FormatTime(TimeSpan time)
    {
        return $"{(int)time.TotalHours:00}.00";
    }

    private static string FormatTimeSlot(ScheduleTimeSlot slot)
    {
        return $"{FormatTime(slot.Start)} - {FormatTime(slot.End)}";
    }

    private static string GetDayName(DateTime day)
    {
        return day.ToString("ddd", IndonesianCulture);
    }

    private static string GetDayHeaderClass(DateTime day)
    {
        var className = "studio-schedule-day-head";

        if (day.Date == DateTime.Today.Date)
        {
            className += " is-today";
        }

        if (day.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)
        {
            className += " is-weekend";
        }

        return className;
    }

    private static string BuildSlotTitle(DateTime day, ScheduleTimeSlot slot)
    {
        return $"{day.ToString("dddd, dd MMMM yyyy", IndonesianCulture)} - {FormatTimeSlot(slot)}";
    }

    private static string BuildSlotAria(DateTime day, ScheduleTimeSlot slot)
    {
        return $"Buka form booking untuk {BuildSlotTitle(day, slot)}";
    }

    private static string FormatCurrency(decimal value)
    {
        return value <= 0
            ? "Rp0"
            : value.ToString("C0", IndonesianCulture);
    }

    private enum ScheduleViewMode
    {
        Day,
        Week,
        Month
    }

    private enum BookingPaymentStatus
    {
        Pending,
        Dp,
        Paid
    }

    private readonly record struct ScheduleTimeSlot(TimeSpan Start, TimeSpan End);

    private sealed record StudioBookingSegment(
        StudioBooking Booking,
        bool IsStart,
        bool IsEnd);

    private sealed record StudioBooking(
        string Id,
        string CustomerName,
        string BandName,
        string PhoneNumber,
        DateTime BookingDate,
        DateTime StartAt,
        DateTime EndAt,
        ScheduleTimeSlot Slot,
        string Duration,
        int DurationHours,
        int CustomDurationHours,
        BookingPaymentStatus Status,
        decimal TotalAmount,
        decimal DpAmount,
        decimal RemainingAmount,
        string Note)
    {
        public string DisplayName => string.IsNullOrWhiteSpace(BandName)
            ? CustomerName
            : BandName;
    }

    private sealed class StudioBookingLocalRecord
    {
        public int SchemaVersion { get; set; } = 1;

        public string Id { get; set; } = string.Empty;

        public string CustomerName { get; set; } = string.Empty;

        public string BandName { get; set; } = string.Empty;

        public string PhoneNumber { get; set; } = string.Empty;

        public DateTime BookingDate { get; set; }

        public DateTime StartAt { get; set; }

        public DateTime EndAt { get; set; }

        public int SlotStartHour { get; set; }

        public int SlotEndHour { get; set; }

        public string Duration { get; set; } = "1 Jam";

        public int DurationHours { get; set; } = 1;

        public int CustomDurationHours { get; set; } = 1;

        public BookingPaymentStatus Status { get; set; }

        public decimal TotalAmount { get; set; }

        public decimal DpAmount { get; set; }

        public decimal RemainingAmount { get; set; }

        public string Note { get; set; } = string.Empty;

        public static StudioBookingLocalRecord FromBooking(StudioBooking booking)
        {
            return new StudioBookingLocalRecord
            {
                SchemaVersion = 1,
                Id = booking.Id,
                CustomerName = booking.CustomerName,
                BandName = booking.BandName,
                PhoneNumber = booking.PhoneNumber,
                BookingDate = booking.BookingDate,
                StartAt = booking.StartAt,
                EndAt = booking.EndAt,
                SlotStartHour = (int)booking.Slot.Start.TotalHours,
                SlotEndHour = (int)booking.Slot.End.TotalHours,
                Duration = booking.Duration,
                DurationHours = booking.DurationHours,
                CustomDurationHours = booking.CustomDurationHours,
                Status = booking.Status,
                TotalAmount = booking.TotalAmount,
                DpAmount = booking.DpAmount,
                RemainingAmount = booking.RemainingAmount,
                Note = booking.Note
            };
        }

        public StudioBooking ToBooking()
        {
            var safeId = string.IsNullOrWhiteSpace(Id)
                ? Guid.NewGuid().ToString("N")
                : Id;

            var safeDurationHours = Math.Max(1, DurationHours);
            var safeSlotStart = SlotStartHour <= 0
                ? StartAt.Hour
                : SlotStartHour;

            var safeSlotEnd = SlotEndHour <= safeSlotStart
                ? safeSlotStart + 1
                : SlotEndHour;

            return new StudioBooking(
                safeId,
                CustomerName.Trim(),
                BandName.Trim(),
                PhoneNumber.Trim(),
                BookingDate.Date,
                StartAt,
                EndAt,
                new ScheduleTimeSlot(TimeSpan.FromHours(safeSlotStart), TimeSpan.FromHours(safeSlotEnd)),
                string.IsNullOrWhiteSpace(Duration) ? $"{safeDurationHours} Jam" : Duration,
                safeDurationHours,
                Math.Max(1, CustomDurationHours),
                Status,
                TotalAmount,
                DpAmount,
                RemainingAmount,
                Note.Trim()
            );
        }
    }
}