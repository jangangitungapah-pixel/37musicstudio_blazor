@inherits Microsoft.AspNetCore.Components.LayoutComponentBase
@using Microsoft.AspNetCore.Components.Routing

<div class="studio-admin-shell">
    <aside class="studio-admin-sidebar" aria-label="Navigasi admin desktop">
        <a class="studio-shell-brand" href="/dashboard" aria-label="37 Music Studio Admin">
            <span class="studio-shell-brand-mark">37</span>

            <span class="studio-shell-brand-copy">
                <strong>37 Music Studio</strong>
                <small>Admin Portal</small>
            </span>
        </a>

        <nav class="studio-shell-nav" aria-label="Menu admin">
            @foreach (var group in NavigationGroups)
            {
                <section class="studio-shell-nav-group" aria-label="@group.Label">
                    <p class="studio-shell-nav-group-label">@group.Label</p>

                    @foreach (var item in group.Items)
                    {
                        <NavLink class="studio-shell-nav-item" ActiveClass="is-active" href="@item.Href" Match="NavLinkMatch.Prefix" title="@item.Description">
                            <StudioIcon Name="@item.Icon" />

                            <span class="studio-shell-nav-copy">
                                <span>@item.Label</span>
                                <small>@item.Description</small>
                            </span>
                        </NavLink>
                    }
                </section>
            }
        </nav>

        <div class="studio-shell-side-footer">
            <div class="studio-shell-status">
                <span></span>
                <strong>Local Access</strong>
            </div>

            <form method="post" action="/local-auth/sign-out">
                <button class="studio-shell-logout" type="submit">
                    <StudioIcon Name="log-out" />
                    <span>Logout</span>
                </button>
            </form>
        </div>
    </aside>

    <main class="studio-admin-main">
        <div class="studio-mobile-topbar" aria-label="Header admin mobile">
            <a class="studio-mobile-brand" href="/dashboard" aria-label="37 Music Studio Admin">
                <span class="studio-shell-brand-mark">37</span>

                <span class="studio-mobile-brand-copy">
                    <strong>37 Music Studio</strong>
                    <small>Admin Portal</small>
                </span>
            </a>

            <div class="studio-mobile-actions">
                <NavLink class="studio-mobile-settings" ActiveClass="is-active" href="/settings" title="Settings" aria-label="Buka settings">
                    <StudioIcon Name="settings" />
                </NavLink>

                <form method="post" action="/local-auth/sign-out">
                    <button class="studio-mobile-logout" type="submit" aria-label="Logout">
                        <StudioIcon Name="log-out" />
                    </button>
                </form>
            </div>
        </div>

        @Body
    </main>

    <nav class="studio-bottom-nav" aria-label="Navigasi admin mobile">
        @foreach (var item in BottomNavigationItems)
        {
            <NavLink class="studio-bottom-nav-item" ActiveClass="is-active" href="@item.Href" Match="NavLinkMatch.Prefix">
                <StudioIcon Name="@item.Icon" />
                <span>@item.ShortLabel</span>
            </NavLink>
        }
    </nav>
</div>

@code {
    private static readonly IReadOnlyList<StudioNavGroup> NavigationGroups = new[]
    {
        new StudioNavGroup("Overview", new[]
        {
            new StudioNavItem("Dashboard", "Home", "/dashboard", "layout-dashboard", "Ringkasan aktivitas studio")
        }),
        new StudioNavGroup("Operasional", new[]
        {
            new StudioNavItem("Schedule", "Schedule", "/schedule", "calendar-days", "Jadwal booking studio"),
            new StudioNavItem("Customer", "Customer", "/customers", "users", "Data pelanggan dan histori"),
            new StudioNavItem("Inventory", "Inventory", "/inventory", "settings", "Daftar alat dan kondisi"),
            new StudioNavItem("Gallery", "Gallery", "/gallery", "image", "Foto studio dan dokumentasi")
        }),
        new StudioNavGroup("Keuangan", new[]
        {
            new StudioNavItem("Billing / POS", "POS", "/billing", "wallet-cards", "Pembayaran dan tagihan"),
            new StudioNavItem("Pembukuan", "Buku", "/bookkeeping", "book-open", "Kas masuk dan kas keluar")
        }),
        new StudioNavGroup("System", new[]
        {
            new StudioNavItem("Settings", "Settings", "/settings", "settings", "Konfigurasi aplikasi")
        })
    };

    private static readonly IReadOnlyList<StudioNavItem> NavigationItems = NavigationGroups
        .SelectMany(group => group.Items)
        .ToArray();

    private static readonly IReadOnlyList<StudioNavItem> BottomNavigationItems = NavigationItems
        .Where(item => item.Href is "/dashboard" or "/schedule" or "/customers" or "/billing" or "/bookkeeping")
        .ToArray();

    private sealed record StudioNavGroup(string Label, IReadOnlyList<StudioNavItem> Items);

    private sealed record StudioNavItem(string Label, string ShortLabel, string Href, string Icon, string Description);
}