@page "/login"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout AdminBlankLayout

<PageTitle>Login Admin | 37 Music Studio</PageTitle>

<main class="studio-login-page theme-container" aria-labelledby="studioLoginTitle">
    <section class="studio-login-panel" aria-label="Login admin 37 Music Studio">
        <aside class="studio-login-visual" aria-label="Informasi portal admin">
            <div class="studio-login-visual__top">
                <div class="studio-login-brandmark" aria-hidden="true">37</div>
                <div class="studio-login-status">
                    <span aria-hidden="true"></span>
                    <strong>Local Admin</strong>
                </div>
            </div>

            <div class="studio-login-visual__content">
                <p class="studio-login-eyebrow">Admin Portal</p>
                <h1 id="studioLoginTitle">37 Music Studio</h1>
                <p>
                    Ruang kendali internal untuk mengelola operasional studio dengan tampilan yang bersih, ringan, dan siap dikembangkan.
                </p>
            </div>

            <div class="studio-login-visual__footer" aria-label="Fitur pondasi">
                <span>Secure local auth</span>
                <span>Responsive shell</span>
                <span>Token based UI</span>
            </div>
        </aside>

        <form class="studio-login-card" method="post" action="/local-auth/sign-in" autocomplete="on">
            <input type="hidden" name="returnUrl" value="@SafeReturnUrl" />

            <div class="studio-login-card__header">
                <p class="studio-login-eyebrow">Secure Local Access</p>
                <h2>Login Admin</h2>
                <span>Masuk untuk membuka cangkang admin 37 Music Studio.</span>
            </div>

            @if (HasError)
            {
                <div class="studio-login-alert" role="alert">
                    @ErrorMessage
                </div>
            }

            <div class="studio-login-fields">
                <label class="studio-login-field">
                    <span>Username</span>
                    <input
                        name="username"
                        type="text"
                        autocomplete="username"
                        inputmode="text"
                        spellcheck="false"
                        placeholder="admin"
                        required />
                </label>

                <label class="studio-login-field">
                    <span>Password</span>
                    <input
                        name="password"
                        type="password"
                        autocomplete="current-password"
                        placeholder="Masukkan password"
                        required />
                </label>
            </div>

            <button class="studio-login-submit" type="submit">
                Masuk ke Admin
            </button>

            <p class="studio-login-note">
                Credential dibaca dari file lokal dan tidak ikut commit.
            </p>
        </form>
    </section>
</main>

@code {
    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private string SafeReturnUrl => StudioAuthReturnUrl.Sanitize(ReturnUrl);

    private bool HasError => !string.IsNullOrWhiteSpace(Error);

    private string ErrorMessage => Error?.Trim().ToLowerInvariant() switch
    {
        "config" => "File auth lokal belum siap atau tidak bisa dibaca. Cek .local/auth.local.json.",
        _ => "Username atau password belum cocok."
    };
}